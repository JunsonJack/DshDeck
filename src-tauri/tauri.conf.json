  "productName": "DshDeck",
  "version": "0.1.0",
  "identifier": "dev.dshdeck.desktop",
  "build": {
    "frontendDist": "../apps/dshdeck-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
