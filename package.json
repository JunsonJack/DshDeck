{
  "name": "dshdeck",
  "private": true,
  "version": "0.1.0",
  "description": "Thin desktop workbench for DeepSeek Harness (dsh) via ACP",
  "type": "module",
  "scripts": {
    "probe": "node probe/acp-probe.mjs",
    "dev:host": "node apps/dshdeck-host/server.mjs",
    "dev:ui": "npm --prefix apps/dshdeck-ui run dev",
    "typecheck:ui": "npm --prefix apps/dshdeck-ui run typecheck",
    "dev": "tauri dev",
    "build": "tauri build",
    "start": "node apps/dshdeck-host/server.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.14",
    "png-to-ico": "^3.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
